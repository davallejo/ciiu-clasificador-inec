# ============================================================
#   FRONTEND NEXT.JS — Variables de entorno (plantilla)
# ============================================================
# Copia este archivo como:   .env
# (NO subas el .env real al repositorio — ya está en .gitignore).

# ------------------------------------------------------------
#  NEXT_PUBLIC_API_URL  (OBLIGATORIA para DESARROLLO LOCAL)
# ------------------------------------------------------------
# URL pública del backend FastAPI, VISIBLE EN EL NAVEGADOR.
# - Lleva el prefijo NEXT_PUBLIC_*  para que Next.js lo inyecte
#   también en los "use client" components.
# - SIN barra (/) al final.
#
# Desarrollo LOCAL:   apunta DIRECTAMENTE al backend en :8000
#                     (evita el proxy de Next.js — menos puntos
#                      de fallo + CORS ya configurado en backend).
# Producción VERCEL:  DEJARLO VACÍO  ("").
#                     Las rutas /api/* usan los rewrites de
#                     vercel.json → apuntan al serverless /api.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------
#  BACKEND_URL  (solo SERVER-SIDE — no se envía al navegador)
# ------------------------------------------------------------
# Lo usa el rewrite server-side de next.config.mjs
#   source: /api/:path*  →  destination: <BACKEND_URL>/api/:path*
# Dejar :8000 en local. En Vercel Next.js no lo necesita porque
# vercel.json tiene sus propios rewrites globales.
BACKEND_URL=http://localhost:8000
