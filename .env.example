# ============================================================
#  VARIABLES DE ENTORNO — PROYECTO CIIU CLASIFICADOR INEC
# ============================================================
# Copia este archivo a .env y rellena con tus valores reales.
# NO SUBAS .env al repositorio (ya está en .gitignore).

# ---------- POSTGRESQL LOCAL (desarrollo) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ciiu_inec
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# URI completa (alternativa — úsala si prefieres DATABASE_URL)
# DATABASE_URL=postgresql://postgres:tu_password_aqui@localhost:5432/ciiu_inec

# ---------- POSTGRESQL REMOTO / VERCEL (producción) ----------
# Cuando despliegues en Vercel, Vercel Storage te crea automáticamente
# la variable POSTGRES_URL. El código la detecta sola.
# También puedes usar DATABASE_URL (ej: Supabase, Neon, Railway).
# POSTGRES_URL=postgres://user:pass@host:port/dbname?sslmode=require
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# ---------- DIRECTORIO CACHÉ DEL CLASIFICADOR ----------
# Por defecto se guarda en ./models (local). En Vercel serverless
# el FS es read-only salvo /tmp, así que el vercel.json ya define:
# CIIU_MODELO_DIR=/tmp/ciiu_models

# ---------- LLM / IA (opcionales — para segunda opinión) ----------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# ---------- CORS ----------
# Orígenes permitidos separados por coma (solo en producción).
# En desarrollo se permiten automáticamente :3000 y :8000.
# CORS_ORIGINS=https://tu-dominio.vercel.app,https://otro.com

# ---------- APP ----------
APP_ENV=development
APP_SECRET_KEY=cambia-esto-en-produccion-por-un-token-largo-aleatorio
